      <aliases enabled='yes' />
      <column caption='ERA' datatype='string' name='[Calculation_663155102774030336]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [career_start] &lt; 1980 THEN &apos;Pre-1980&apos;&#13;&#10;ELSEIF [career_start] &lt; 2000 THEN &apos;1980-1999&apos;&#13;&#10;ELSEIF [career_start] &lt; 2010 THEN &apos;2000-2009&apos;&#13;&#10;ELSEIF [career_start] &lt; 2020 THEN &apos;2010-2019&apos;&#13;&#10;ELSE &apos;2020+&apos;&#13;&#10;END' />
      </column>
      <column caption='Non-Pole Starts' datatype='integer' name='[Calculation_820218138720292869]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[totalRaceStarts] - [totalPolePositions]' />
      </column>
      <column caption='[Dynamic GOAT Score]' datatype='integer' name='[Calculation_820218138723749894]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1] * [totalChampionshipWins] +&#13;&#10;    [Parameters].[Parameter 2] * [totalRaceWins] +&#13;&#10;    [Parameters].[Parameter 3] * [totalPodiums] +&#13;&#10;    [Parameters].[Parameter 4] * [totalPolePositions]' />
      </column>
