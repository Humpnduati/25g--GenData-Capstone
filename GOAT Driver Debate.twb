              <calculation class='tableau' formula='FLOAT([duration])' />
            </column>
            <column caption='Avg Pit Stop (Constructor)' datatype='real' name='[Calculation_334955274475995170]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([Calculation_334955274474475551])' />
            </column>
            <column caption='Norm Points' datatype='real' name='[Calculation_770960013099925506]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([total_points]) - WINDOW_MIN(SUM([total_points]))) &#13;&#10;/&#13;&#10;(WINDOW_MAX(SUM([total_points])) - WINDOW_MIN(SUM([total_points])))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Norm Wins' datatype='real' name='[Calculation_770960013100101635]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([wins]) - WINDOW_MIN(SUM([wins]))) / (WINDOW_MAX(SUM([wins])) - WINDOW_MIN(SUM([wins])))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Norm Podiums' datatype='real' name='[Calculation_770960013100253188]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([podiums]) - WINDOW_MIN(SUM([podiums]))) / (WINDOW_MAX(SUM([podiums])) - WINDOW_MIN(SUM([podiums])))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Norm Avg Finish' datatype='real' name='[Calculation_770960013100515333]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1 - (&#13;&#10;  (AVG([avg_finish]) - WINDOW_MIN(AVG([avg_finish])))&#13;&#10;  /&#13;&#10;  (WINDOW_MAX(AVG([avg_finish])) - WINDOW_MIN(AVG([avg_finish])))&#13;&#10;)&#13;&#10;&#13;&#10;// (inverse: lower is better)&#13;&#10;//(This makes a better (1.0) value for lower avg finish.)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Norm Longevity' datatype='real' name='[Calculation_770960013100912646]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(COUNT([__tableau_internal_object_id__].[races_0529F0E65D1146978DA71BAC39095F0C]) - WINDOW_MIN(COUNT([__tableau_internal_object_id__].[races_0529F0E65D1146978DA71BAC39095F0C]))) / (WINDOW_MAX(COUNT([__tableau_internal_object_id__].[races_0529F0E65D1146978DA71BAC39095F0C])) - WINDOW_MIN(COUNT([__tableau_internal_object_id__].[races_0529F0E65D1146978DA71BAC39095F0C])))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Custom Goat Score' datatype='real' name='[Calculation_770960013105221645]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1]*[Calculation_770960013099925506] +&#13;&#10;[Parameters].[Parameter 2]*[Calculation_770960013100101635] +&#13;&#10;[Parameters].[Parameter 3]*[Calculation_770960013100253188] +&#13;&#10;[Parameters].[Parameter 4]*[Calculation_770960013100515333] +&#13;&#10;[Parameters].[Parameter 5]*[Calculation_770960013100912646]'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Driver Rank' datatype='integer' name='[Calculation_770960013105582094]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RANK_UNIQUE(([Calculation_770960013105221645]), &apos;desc&apos;)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Top N Filter' datatype='boolean' name='[Calculation_770960013110005775]' role='measure' type='nominal'>
              <calculation class='tableau' formula='[Calculation_770960013105582094] &lt;= [Parameters].[Parameter 6]'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='races' datatype='table' name='[__tableau_internal_object_id__].[races_0529F0E65D1146978DA71BAC39095F0C]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_334955274474475551]' derivation='Avg' name='[avg:Calculation_334955274474475551:qk]' pivot='key' type='quantitative' />
