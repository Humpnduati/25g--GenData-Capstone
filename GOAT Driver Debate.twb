      <column caption='Constructor Colors' datatype='string' name='[Calculation_518195484128436246]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [name (constructors)] &#13;&#10;    WHEN &quot;Ferrari&quot; THEN &quot;FF2800&quot;     // Ferrari red&#13;&#10;    WHEN &quot;Mercedes&quot; THEN &quot;00D2BE&quot;   // Mercedes teal&#13;&#10;    WHEN &quot;Red Bull&quot; THEN &quot;1E41FF&quot;   // Red Bull navy blue&#13;&#10;    WHEN &quot;McLaren&quot; THEN &quot;FF8700&quot;    // Papaya orange&#13;&#10;    WHEN &quot;Williams&quot; THEN &quot;005AFF&quot;   // Dark blue&#13;&#10;    WHEN &quot;Aston Martin&quot; THEN &quot;006F62&quot; // British racing green&#13;&#10;    WHEN &quot;Alpine&quot; THEN &quot;0090FF&quot;     // Alpine blue&#13;&#10;    WHEN &quot;AlphaTauri&quot; THEN &quot;2B4562&quot; // Navy / slate&#13;&#10;    WHEN &quot;Sauber&quot; THEN &quot;900000&quot;     // Deep red&#13;&#10;    ELSE &quot;808080&quot;                   // Gray fallback&#13;&#10;END' />
